# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Server-only secrets: do NOT prefix any of these with NEXT_PUBLIC_ (that would bundle them
# into client JavaScript).

PAGESPEED_API_KEY=
OPENAI_API_KEY=
# Optional. Defaults to gpt-5 in code. Check the provider docs for current model IDs.
OPENAI_MODEL=
